{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-remote-station",
  "version": "0.5.0",
  "identifier": "com.ccworkstation.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cc-remote-station",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "copyright": "Copyright (c) 2026 qiyifeng. MIT License.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNDNCQTFDNUU4QTVBMDIKUldRQ1dvcGVITHBEMDBQWmh3ejVGM2liMnlNTFFtWXlnaGRtZ3BqM2hkUFZwWjIwVTdOUjN0SnYK",
      "endpoints": ["https://github.com/simplifyOurLife/cc-remote-station/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
